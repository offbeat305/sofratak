# Copy this file to `.env.local` (same folder) and fill in the values.
# `.env.local` is gitignored — secrets never get committed.
# Leave any line blank to keep using the local mock for that service.

# ── Supabase (database + auth) — needed for Phase 4 ─────────────────
# From: supabase.com → your project → Settings → API
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (payments, TEST MODE keys — they start with sk_test_/pk_test_)
# From: dashboard.stripe.com → Developers → API keys (Test mode toggle ON)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Twilio (SMS) — optional for now, mock SMS works fine until launch ─
# From: console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Stripe webhooks (production only; local dev verifies on redirect) ─
# From: dashboard.stripe.com → Developers → Webhooks → your endpoint
STRIPE_WEBHOOK_SECRET=

# ── Internal admin impersonation (Phase 7) — required to use "Log in as
# owner" in /admin. Generate with: openssl rand -hex 32
IMPERSONATION_SECRET=

# ── Marketing site ────────────────────────────────────────────────────
# WhatsApp number, digits only with country code, e.g. 18135551234
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Lead notification email (Resend) — console fallback until key exists
RESEND_API_KEY=
LEADS_EMAIL=offbeat305@gmail.com
# Canonical site URL for sitemap/OG
NEXT_PUBLIC_SITE_URL=https://www.sofratak.com
